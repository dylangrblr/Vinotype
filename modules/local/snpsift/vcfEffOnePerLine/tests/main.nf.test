nextflow_process {

    name "Test Process SNPSIFT_VCFEFFONEPERLLINE"
    script "../main.nf"
    process "SNPSIFT_VCFEFFONEPERLLINE"

    tag "modules"
    tag "modules_local"
    tag "snpsift"
    tag "snpsift/vcfeffoneperlline"

    test("sarscov2 - vcf.gz - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
