graph LR

  subgraph INPUT_LINE[Input Routing]
    INPUT[ ]
    PARSE[Parse samplesheet]
    FASTQ[ ]
    GZ_INPUT[ ]
    GVCF_INPUT[ ]
    INPUT -->|main| PARSE
    PARSE -->|fastq| FASTQ
    PARSE -->|genozip| GZ_INPUT
    PARSE -->|gvcf| GVCF_INPUT
  end

  subgraph QC_LINE[Quality control]
    %%metro entry: left | fastq
    FASTQC[FastQC]
    FASTP[fastp]
    FILTERED_READS[ ]
    MULTIQC[MultiQC]
    QC_REPORT[ ]
    FASTQC -->|fastq| FASTP
    FASTP -->|fastq| FILTERED_READS
    FASTP -->|fastq| MULTIQC
    MULTIQC -->|fastq| QC_REPORT
  end

  subgraph ALIGN_LINE[Reference alignment]
    %%metro entry: left | fastq, genozip
    REF[ ]
    IDX[BWA index]
    ALIGN[BWA-MEM2]
    PICARD[Picard SortSam]
    PICARD2[Picard MarkDuplicates]
    SAMTOOLS[Samtools view]
    GZC[Genozip]
    GENOZIP_BAM[ ]
    BAMT[Samtools index]
    FLAGS[Samtools Flagstat]
    REF -->|main| IDX
    IDX -->|fastq| ALIGN
    ALIGN -->|fastq| PICARD
    PICARD -->|fastq| PICARD2
    PICARD2 -->|fastq| SAMTOOLS
    SAMTOOLS -->|fastq| GZC
    GZC -->|fastq| GENOZIP_BAM
    GZC -->|fastq| BAMT
    GZC -->|genozip| BAMT
    BAMT -->|fastq| FLAGS
    BAMT -->|genozip| FLAGS
  end

  subgraph CALL_LINE[Variant calling]
    %%metro direction: TB
    %%metro entry: left | fastq, genozip, gvcf
    %%metro exit: bottom | fastq, genozip, gvcf
    HC[HaplotypeCaller]
    GZD[Genozip decompress]
    SPLIT[bcftools view]
    HC -->|fastq| SPLIT
    HC -->|genozip| SPLIT
    GZD -->|gvcf| SPLIT
  end

  subgraph JOINT_LINE[Joint genotyping per chr]
    %%metro direction: RL
    %%metro entry: top | fastq, genozip, gvcf
    %%metro exit: left | fastq, genozip, gvcf
    REBLOCK[ReblockGVCF]
    GDB[GenomicsDBImport]
    GT[GenotypeGVCFs]
    REBLOCK -->|fastq| GDB
    REBLOCK -->|genozip| GDB
    REBLOCK -->|gvcf| GDB
    GDB -->|fastq| GT
    GDB -->|genozip| GT
    GDB -->|gvcf| GT
  end

  subgraph FILTER_LINE[Variant filtering per chr]
    %%metro direction: RL
    %%metro entry: right | fastq, genozip, gvcf
    SELECTVARIANTS[SelectVariants]
    TABLE[VariantsToTable]
    FINAL[bcftools filter]
    SELECTVARIANTS -->|fastq| TABLE
    SELECTVARIANTS -->|genozip| TABLE
    SELECTVARIANTS -->|gvcf| TABLE
    TABLE -->|fastq| FINAL
    TABLE -->|genozip| FINAL
    TABLE -->|gvcf| FINAL
  end

  subgraph ANNO_LINE[Variant effect prediction per chr]
    %%metro direction: RL
    %%metro entry: right | fastq, genozip, gvcf
    MERGE[MergeVcfs]
    SNPEFF[SnpEff annotate]
    SNPSIFT[SnpSift filter]
    MQC[MultiQC]
    M[ ]
    MERGE -->|fastq| SNPEFF
    MERGE -->|genozip| SNPEFF
    MERGE -->|gvcf| SNPEFF
    SNPEFF -->|fastq| SNPSIFT
    SNPEFF -->|genozip| SNPSIFT
    SNPEFF -->|gvcf| SNPSIFT
    SNPSIFT -->|fastq| MQC
    SNPSIFT -->|genozip| MQC
    SNPSIFT -->|gvcf| MQC
    MQC -->|fastq| M
    MQC -->|genozip| M
    MQC -->|gvcf| M
  end

  %% Cross-subgraph edges — declared at top level
  FASTQ -->|fastq| FASTQC
  FILTERED_READS -->|fastq| ALIGN
  GZ_INPUT -->|genozip| GZC
  GVCF_INPUT -->|gvcf| GZD
  FLAGS -->|fastq| HC
  FLAGS -->|genozip| HC
  SPLIT -->|fastq| REBLOCK
  SPLIT -->|genozip| REBLOCK
  SPLIT -->|gvcf| REBLOCK
  GT -->|fastq| SELECTVARIANTS
  GT -->|genozip| SELECTVARIANTS
  GT -->|gvcf| SELECTVARIANTS
  FINAL -->|fastq| MERGE
  FINAL -->|genozip| MERGE
  FINAL -->|gvcf| MERGE
