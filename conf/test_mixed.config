/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run dylangrblr/vinotype -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]

    withName: 'UTILS_FINALFILTER' {

        ext.args_bcftools_norm_1 = {[
            "-m",
            "-both",
            "--multi-overlaps 0"
        ].join(' ').trim()}


        //SNP filter
        ext.args_bcftools_filter_snps = {[
            "SOR >= ${params.filter_sor} ",
            "FS >= ${params.filter_fs} ",
            "ReadPosRankSum <= ${params.filter_readposranksum} ",
            "MQRankSum <= ${params.filter_mqranksum} ",
            "QD <= ${params.filter_qd}",
            "FORMAT/DP < ${params.filter_format_dp}",
            "AC < ${params.filter_ac}",
        ].join(' || ').trim()}

        ext.args_bcftools_norm_2 = {[
            "-m",
            "+both",
        ].join(' ').trim()}


        ext.args_bcftools_view = {[
            "--max-alleles 2"
        ].join(' ').trim()}


        ext.args_vcftools = {[
            "--recode",
            "--max-missing 0.8",
        ].join(' ').trim()}


        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: "${params.outdir}/variant_calling/filtered",
                pattern: "*.vcf\\.gz",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]



    }

}

params {
    config_profile_name        = 'Test profile ( FASTQ + BAM + GVCF )'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input  = "${projectDir}/assets/samplesheets/test.mixed.csv"
}
