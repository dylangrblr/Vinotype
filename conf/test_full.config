/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full-size pipeline test.

    Use as follows:
        nextflow run dylangrblr/vinotype -profile test_full,<docker/singularity> --outdir <OUTDIR>

    Full-size grapevine samples (Dong et al. 2023), several GB each, hosted at
    https://doi.org/10.5281/zenodo.17062459
----------------------------------------------------------------------------------------
*/

process {
    // Full-size data — give tasks real resources (these are caps; per-process
    // requests from base.config still apply below them).
    resourceLimits = [
        cpus:   16,
        memory: '72.GB',
        time:   '48.h'
    ]

    withName: 'UTILS_FINALFILTER' {

        ext.args_bcftools_norm_1 = {[
            "-m",
            "-both",
            "--multi-overlaps 0"
        ].join(' ').trim()}

        //SNP filter
        ext.args_bcftools_filter_snps = {[
            "SOR >= ${params.filter_sor} ",
            "FS >= ${params.filter_fs} ",
            "ReadPosRankSum <= ${params.filter_readposranksum} ",
            "MQRankSum <= ${params.filter_mqranksum} ",
            "QD <= ${params.filter_qd}",
            "COUNT(FORMAT/DP[*] < ${params.filter_format_dp}) / N_SAMPLES > ${params.filter_format_dp_fraction}",
            "AC < ${params.filter_ac}",
        ].join(' || ').trim()}

        ext.args_bcftools_norm_2 = {[
            "-m",
            "+both",
        ].join(' ').trim()}

        ext.args_bcftools_view = {[
            "--max-alleles 2"
        ].join(' ').trim()}

        ext.args_vcftools = {[
            "--recode",
            "--max-missing 0.8",
        ].join(' ').trim()}

        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: "${params.outdir}/variant_calling/filtered",
                pattern: "*.vcf\\.gz",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]

    }

}

params {
    config_profile_name        = 'Full test profile (FASTQ)'
    config_profile_description = 'Full-size test dataset to check pipeline function'

    // Input data — full-size grapevine FASTQ samples (Dong et al. 2023),
    // hosted at https://doi.org/10.5281/zenodo.17062459
    input  = "${projectDir}/assets/samplesheets/test_full.fastq.csv"

    // Reference genome — grapevine T2T (Vitis vinifera, GCF_030704535.1),
    // from the Zenodo T2T test bundle (chr01–chr19). Indexes built at runtime.
    ref_fasta          = 'https://zenodo.org/records/21335002/files/T2T_ref.fasta'
    ref_intervals_list = 'https://zenodo.org/records/21335002/files/intervals.list'

    // No genozip required for plain FASTQ input
    use_genozip = false

    // Full pipeline: alignment → variant calling → joint genotyping → filtering
    skip_merged_analysis = false
}
