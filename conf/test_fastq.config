/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run dylangrblr/vinotype -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]

    withName: 'UTILS_FINALFILTER' {

        ext.args_bcftools_norm_1 = {[
            "-m",
            "-both",
            "--multi-overlaps 0"
        ].join(' ').trim()}


        //SNP filter
        ext.args_bcftools_filter_snps = {[
            "SOR >= ${params.filter_sor} ",
            "FS >= ${params.filter_fs} ",
            "ReadPosRankSum <= ${params.filter_readposranksum} ",
            "MQRankSum <= ${params.filter_mqranksum} ",
            "QD <= ${params.filter_qd}",
            "COUNT(FORMAT/DP[*] < ${params.filter_format_dp}) / N_SAMPLES > ${params.filter_format_dp_fraction}",
            "AC < ${params.filter_ac}",
        ].join(' || ').trim()}

        ext.args_bcftools_norm_2 = {[
            "-m",
            "+both",
        ].join(' ').trim()}


        ext.args_bcftools_view = {[
            "--max-alleles 2"
        ].join(' ').trim()}


        ext.args_vcftools = {[
            "--recode",
            "--max-missing 0.8",
        ].join(' ').trim()}


        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: "${params.outdir}/variant_calling/filtered",
                pattern: "*.vcf\\.gz",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]

    }

}

params {
    config_profile_name        = 'Test profile (FASTQ)'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data — 5 × 100k subsampled grapevine samples (Dong et al. 2023)
    // hosted at https://doi.org/10.5281/zenodo.21335002
    input  = "${projectDir}/assets/samplesheets/test.fastq.csv"

    // Reference genome — grapevine T2T (Vitis vinifera, GCF_030704535.1),
    // from the Zenodo T2T test bundle (chr01–chr19, matches the genozip
    // BAM/gVCF inputs and the SnpEff DB). Indexes are built at runtime.
    ref_fasta          = 'https://zenodo.org/records/21335002/files/T2T_ref.fasta'
    ref_intervals_list = 'https://zenodo.org/records/21335002/files/intervals.list'

    // No genozip required for plain FASTQ input
    use_genozip = false

    // Run the full pipeline (joint genotyping + filtering). Set to true to
    // stop after per-sample variant calling for a faster smoke test.
    skip_merged_analysis = false
}
