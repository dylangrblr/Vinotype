/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run dylangrblr/vinotype -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]

    withName: 'UTILS_FINALFILTER' {

        ext.args_bcftools_norm_1 = {[
            "-m",
            "-both",
            "--multi-overlaps 0"
        ].join(' ').trim()}


        //SNP filter
        ext.args_bcftools_filter_snps = {[
            "SOR >= ${params.filter_sor} ",
            "FS >= ${params.filter_fs} ",
            "ReadPosRankSum <= ${params.filter_readposranksum} ",
            "MQRankSum <= ${params.filter_mqranksum} ",
            "QD <= ${params.filter_qd}",
            "COUNT(FORMAT/DP[*] < ${params.filter_format_dp}) / N_SAMPLES > ${params.filter_format_dp_fraction}",
            "AC < ${params.filter_ac}",
        ].join(' || ').trim()}

        ext.args_bcftools_norm_2 = {[
            "-m",
            "+both",
        ].join(' ').trim()}


        ext.args_bcftools_view = {[
            "--max-alleles 2"
        ].join(' ').trim()}


        ext.args_vcftools = {[
            "--recode",
            "--max-missing 0.8",
        ].join(' ').trim()}


        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: "${params.outdir}/variant_calling/filtered",
                pattern: "*.vcf\\.gz",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]



    }

}

params {
    config_profile_name        = 'Test profile (BAM.genozip)'
    config_profile_description = 'Minimal test dataset to check pipeline function (BAM input via genozip)'

    // Input data — 5 × 100k subsampled grapevine BAM.genozip files (Dong et al. 2023)
    // hosted at https://doi.org/10.5281/zenodo.21335002
    input  = "${projectDir}/assets/samplesheets/test.bam.csv"

    // Reference genome — grapevine T2T (Zenodo bundle, chr01–chr19).
    ref_fasta          = 'https://zenodo.org/records/21335002/files/T2T_ref.fasta'
    ref_intervals_list = 'https://zenodo.org/records/21335002/files/intervals.list'

    // NOTE: .bam.genozip input requires a genozip license (not public), so this
    // profile is NOT runnable in plain CI — use `test`/`test_fastq` for that.
    // Provide a license at runtime:  --use_genozip true --genozip_license_file <path>
    use_genozip          = false
    genozip_license_file = null

    skip_merged_analysis = false
}
