/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        enabled: false,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

//----------------------
// PREPROCESSING - QUALITY CONTROL MODULES
//----------------------
    withName: 'FASTQC_PRE' {
        ext.args = '--quiet'
        publishDir = [
                    path: { "${params.outdir}/preprocessing/reports/fastqc" },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
    }

    withName: 'FASTP' {
        ext.args = ''
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: "${params.outdir}/preprocessing/trimmed_reads",
                pattern: "*fastp.fastq.gz",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/preprocessing/reports/fastp" },
                pattern: "*fastp.html",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]
    }



//----------------------
// REFERENCE ALIGNMENT MODULES
//----------------------


//--- INDEX MODULES ---

    withName: 'BCFTOOLS_INDEX' {
        ext.args = {[
            "--tbi",
        ].join(' ').trim()}
    }


    withName: 'GENOZIP_REFERENCE' {
        ext.args = {[
            "--md5",
            "--quiet"
        ].join(' ').trim()}
    }



//------

    withName: 'BWAMEM2_MEM' {
        ext.args = ''
    }


    withName: 'PICARD_SORTSAM'{
        ext.prefix = { "${meta.id}.sorted"}
        ext.args = {[
            "VALIDATION_STRINGENCY=SILENT",
        ].join(' ').trim()}

        publishDir = [
                    path: { "${params.outdir}/alignment/raw" },
                    mode: params.publish_dir_mode,
                    pattern: "*.{bam,bai}",
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]

    }



//TODO: @abhi18av, confirm the exact use-case for RGLB
    withName: 'PICARD_ADDORREPLACEREADGROUPS'{
        ext.prefix = { "${meta.id}.replaced"}
        ext.args = {[
            "RGPU=1",
            "RGID=dong",
            "RGLB=FIXME",
            "RGPL=ILLUMINA",
            "RGSM=${meta.id}.sam",
        ].join(' ').trim()}


    }

    withName: 'PICARD_MARKDUPLICATES'{
        ext.prefix = { "${meta.id}.filt_dp"}
        // ext.args = {[
        //     "REMOVE_DUPLICATES=true",
        //     "VALIDATION_STRINGENCY=SILENT",
        // ].join(' ').trim()}

        publishDir = [
                    path: { "${params.outdir}/alignment/preprocessed/" },
                    mode: params.publish_dir_mode,
                    pattern: "*.{bam,bai}",
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
    }



    withName: 'SAMTOOLS_FLAGSTAT_PRE'{
        ext.prefix = { "${meta.id}.pre"}
        publishDir = [
                    path: { "${params.outdir}/alignment/reports/" },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
    }

    withName: 'SAMTOOLS_FLAGSTAT_POST'{
        ext.prefix = { "${meta.id}.post"}
        publishDir = [
                    path: { "${params.outdir}/alignment/reports/" },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
    }


    withName: 'SAMTOOLS_VIEW' {
        ext.args = '-f 0x2 -F 0x904 -b -h'
        ext.args = {[
            "--output-fmt bam",
        ].join(' ').trim()}
    }

    withName: 'GENOZIP_COMPRESS__BAM' {
        ext.prefix = "${meta.id}.bam"

        ext.args = {[
            "--md5",
            "--quiet"
        ].join(' ').trim()}

        publishDir = [
                    path: { "${params.outdir}/alignment/preprocessed_compressed/" },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
    }




    withName: 'GENOZIP_DECOMPRESS__BAM' {
        ext.prefix = "${meta.id}.bam"

        ext.args = {[
            "--md5",
            "--quiet"
        ].join(' ').trim()}

        publishDir = [
                    path: { "${params.outdir}/alignment/preprocessed_decompressed/" },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
    }



//----------------------
// VARIANT CALLING MODULES
//----------------------


    withName: 'GENOZIP_COMPRESS__GVCF' {
        ext.prefix = "${meta.id}.g.vcf"

        ext.args = {[
            "--md5",
            "--quiet"
        ].join(' ').trim()}

        publishDir = [
                    path: { "${params.outdir}/variant_calling/gvcf_compressed/" },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
    }



    withName: 'GENOZIP_DECOMPRESS__GVCF' {
        ext.prefix = "${meta.id}.g.vcf"

        ext.args = {[
            "--md5",
            "--quiet"
        ].join(' ').trim()}

        publishDir = [
                    path: { "${params.outdir}/variant_calling/gvcf_decompressed/" },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
    }




    withName: 'GATK4_HAPLOTYPECALLER' {
        ext.prefix = { "${meta.id}.g" }
        ext.args = {[
            "--pcr-indel-model NONE",
            "--output-mode EMIT_VARIANTS_ONLY",
            "-ERC GVCF",
            "-G StandardAnnotation",
            "-G StandardHCAnnotation",
            "-G AS_StandardAnnotation",
        ].join(' ').trim()}

        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: "${params.outdir}/variant_calling/gvcf",
                pattern: "*.vcf\\.gz",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]
    }


    withName: 'GATK4_GENOMICSDBIMPORT' {
        ext.args = {[
            "--genomicsdb-shared-posixfs-optimizations TRUE",
        ].join(' ').trim()}
    }

    withName: 'GATK4_GENOTYPEGVCFS' {
        ext.prefix = { "${meta.id}.g" }

        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: "${params.outdir}/variant_calling/joint_raw",
                pattern: "*.vcf\\.gz",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]

    }

    withName: 'GATK4_SELECTVARIANTS__SNP' {
        ext.prefix = { "${meta.id}.raw_${var_type}" }
        ext.java_opts = {[
            "-XX:ParallelGCThreads=2",
            "-XX:+UseParallelGC",
        ].join(' ').trim()}
    }

    withName: 'GATK4_SELECTVARIANTS__INDEL' {
        ext.prefix = { "${meta.id}.raw_${var_type}" }
        ext.java_opts = {[
            "-XX:ParallelGCThreads=2",
            "-XX:+UseParallelGC",
        ].join(' ').trim()}
    }


    withName: 'UTILS_FINALFILTER'{
        ext.args_bcftools_norm_1 = {[
            "-m",
            "-both",
            "--multi-overlaps 0"
        ].join(' ').trim()}


        ext.args_bcftools_filter = {[
            "SOR >= 3.5 ",
            "FS >= 50.0 ",
            "ReadPosRankSum <= -2.0 ",
            "MQRankSum <= -3.0 ",
            "QD <= 10.0 ",
            "COUNT(FORMAT/GQ <= 10) / N_SAMPLES > 0.25 ",
            "COUNT(GT[*] == \"0/1\" & AD[*:1] < 2) / COUNT(GT[*] == \"0/1\") > 0.0 ",
            "COUNT(GT[*] == \"1/1\" & AD[*:1] < 4) / COUNT(GT[*] == \"1/1\") > 0.0 ",
            "FORMAT/DP < 2 ",
            "AC < 2"
        ].join(' || ').trim()}


        ext.args_bcftools_norm_2 = {[
            "-m",
            "+both",
        ].join(' ').trim()}


        ext.args_bcftools_view = {[
            "--max-alleles 2"
        ].join(' ').trim()}

        ext.args_vcftools = {[
            "--recode",
            "--max-missing 0.8",
        ].join(' ').trim()}


        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: "${params.outdir}/variant_calling/filtered",
                pattern: "*.vcf\\.gz",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]



    }

//----------------------
// PIPELINE INFO MODULES
//----------------------

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
