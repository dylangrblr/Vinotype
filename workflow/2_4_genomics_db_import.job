#!/bin/bash
#PBS -l select=1:ncpus=2:mem=124GB
#PBS -N db_import
#PBS -M dylang@sun.ac.za
#PBS -m abe
#PBS -e /home/dylang/dong_reseq/logs/2_4_genomics_db_import.err
#PBS -o /home/dylang/dong_reseq/logs/2_4_genomics_db_import.out
#PBS -l walltime=24:00:00

#Load modules
module load app/gatk/4.4.0.0
module load app/bcftools/1.19

#Paths --> Initial construction of db requires very long walltime
#5 bins ~ 24h for initial database creation

#Paths passed
base_dir="/home/dylang/dong_reseq"
vcf_input="${base_dir}/concat/concat_151_250"

#Other paths
JAVA_OPTS="-Xmx124g -XX:ParallelGCThreads=2 -XX:+UseParallelGC"
PN_ref="/home/dylang/PN_ref"
genotype_GVCF="${base_dir}/workflow/2_5_genotype_GVCF.job"

Vitis_DB="${base_dir}/concat/Vitis_DB"
sample_map="${vcf_input}/Vv_sample.map"
output_norm="${vcf_input}/processed/normalised"
output_reblock="${vcf_input}/processed/reblocked"
output_variants="${vcf_input}/processed/raw_variants"
output_gvcf="${vcf_input}/processed/genotype_GVCF"

#Create directories if they don't exist
mkdir -p "${output_norm}" "${output_reblock}" "${output_gvcf}" "${output_variants}"

#Check if intervals.list exists, if not, create it
if [[ ! -s "${vcf_input}/intervals.list" ]]; then
	cat <<EOL > "${vcf_input}/intervals.list"
chr01
chr02
chr03
chr04
chr05
chr06
chr07
chr08
chr09
chr10
chr11
chr12
chr13
chr14
chr15
chr16
chr17
chr18
chr19
chr00
EOL
	echo "intervals.list created"
else
	echo "intervals.list exists"
fi

#Set chr_input_list path
chr_input_list="${vcf_input}/intervals.list"

#Normalise and index VCF files
for file in "${vcf_input}/processed/combined"/*.vcf.gz; do
	normalised_file="${output_norm}/normalised_$(basename "$file")"
	
	if [[ -f "${normalised_file}.tbi" ]]; then
		echo "Normalised file: ${normalised_file} exists"
	else
		bcftools norm -m +any -f "${PN_ref}/T2T_ref.fasta" -o "${normalised_file}" -Oz "$file"
		
		if [[ ! -s "${normalised_file}.tbi" ]]; then
			bcftools index -t -f "${normalised_file}"
		fi
	fi
done

#Reblock and index VCF files
for file in "${output_norm}"/*.vcf.gz; do
	reblocked_file="${output_reblock}/reblocked_$(basename "$file")"
	
	if [[ -f "${reblocked_file}.tbi" ]]; then
		echo "Reblocked file: ${reblocked_file} exists"
	else
		#Reblock function
		gatk --java-options "${JAVA_OPTS}" ReblockGVCF \
			-R "${PN_ref}/T2T_ref.fasta" \
			-V "${file}" \
			--keep-all-alts \
			-O "${reblocked_file}"
			
		if [[ ! -s "${reblocked_file}.tbi" ]]; then
			bcftools index -t -f "${reblocked_file}"
		fi
	fi
done
	
#Initialise sample map
> "${sample_map}"

#Create sample map file
for vcf in "${output_reblock}"/*.vcf.gz; do
	n=$(bcftools query -l "$vcf")
	
	#Write sample names and VCF file name to output
	for sample in $n; do
		echo -e "${sample}\t${vcf}" >> "${sample_map}"
	done
done

echo "Sample map created: ${sample_map}"

#Initialise or update GenomicsDBImport
if [ -d "${Vitis_DB}" ] && [ "$(ls -A "${Vitis_DB}" 2>/dev/null)" ]; then
    echo "Vitis_DB already built; updating"
    gatk --java-options "${JAVA_OPTS}" GenomicsDBImport \
        --sample-name-map "${sample_map}" \
        --genomicsdb-update-workspace-path "${Vitis_DB}" \
        -L "${chr_input_list}" \
        --genomicsdb-shared-posixfs-optimizations TRUE || { echo "Failed to update Vitis_DB"; exit 1; }
else
    echo "Building Vitis_DB"
    gatk --java-options "${JAVA_OPTS}" GenomicsDBImport \
        --sample-name-map "${sample_map}" \
        --genomicsdb-workspace-path "${Vitis_DB}" \
        -L "${chr_input_list}" \
        --genomicsdb-shared-posixfs-optimizations TRUE || { echo "Failed to create Vitis_DB"; exit 1; }
fi

#Submitting genotypeGVCF
qsub -v base_dir="${base_dir}",vcf_input="${vcf_input}",PN_ref="${PN_ref}",output_gvcf="${output_gvcf}",db_input="${Vitis_DB}",JAVA_OPTS="${JAVA_OPTS}" "${genotype_GVCF}"
echo "Submitted genotypeGVCF"
